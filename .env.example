# ╔══════════════════════════════════════════════════════════════════╗
# ║         NisFlow Finance — Environment Variable Contract          ║
# ║  Source-verified: git grep process.env.* — 2026-08-30          ║
# ╚══════════════════════════════════════════════════════════════════╝
#
# HOW TO USE
#   cp .env.example .env.local   (then fill in real values)
#   .env.local is gitignored — never commit credentials.
#
# SECURITY RULE
#   NEXT_PUBLIC_* variables are embedded in the browser bundle.
#   NEVER put SUPABASE_SECRET_KEY or any server secret under NEXT_PUBLIC_*.
# ──────────────────────────────────────────────────────────────────────


# ── SUPABASE ──────────────────────────────────────────────────────────
# REQUIRED | PUBLIC | browser + server
# Your Supabase project URL.
# Used by: src/lib/supabase/client.ts, server.ts, middleware.ts, next.config.ts
NEXT_PUBLIC_SUPABASE_URL=

# REQUIRED | PUBLIC | browser + server
# Supabase publishable (anon) key — safe to expose in the browser.
# Format: sb_publishable_<...>
# Used by: src/lib/supabase/client.ts, server.ts, src/lib/supabase/middleware.ts
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# REQUIRED | SERVER-ONLY SECRET | never use NEXT_PUBLIC_ prefix
# Supabase service-role secret key. Used ONLY by createAdminClient() in
# src/lib/supabase/server.ts, called exclusively from the CRON endpoint
# after timing-safe bearer token validation.
SUPABASE_SECRET_KEY=


# ── CRON JOBS ─────────────────────────────────────────────────────────
# REQUIRED | SERVER-ONLY SECRET
# Bearer token for the recurring-transaction CRON endpoint.
# Caller sends: Authorization: Bearer <CRON_SECRET>
# Validated with crypto.timingSafeEqual() (no timing-attack exposure).
# Used by: src/app/api/recurring/execute/route.ts
CRON_SECRET=


# ── GOOGLE AI (GEMINI) ────────────────────────────────────────────────
# REQUIRED | SERVER-ONLY SECRET
# Primary Google Generative AI API key.
# The code checks in order: GOOGLE_GENERATIVE_AI_API_KEY → GEMINI_API_KEY → GOOGLE_API_KEY
# Used by: src/lib/ai/config.ts → /api/chat, /api/ai/categorize, /api/ai/insights
GOOGLE_GENERATIVE_AI_API_KEY=

# OPTIONAL | SERVER-ONLY SECRET | fallback alias for GOOGLE_GENERATIVE_AI_API_KEY
# Only needed if you prefer this naming. Source: src/lib/ai/config.ts:42
# GEMINI_API_KEY=

# OPTIONAL | SERVER-ONLY SECRET | fallback alias for GOOGLE_GENERATIVE_AI_API_KEY
# Source: src/lib/ai/config.ts:43
# GOOGLE_API_KEY=

# OPTIONAL | SERVER-ONLY
# Override the Gemini model. Default: gemini-2.5-flash
# Note: gemini-2.0-flash and gemini-2.0-flash-exp are auto-remapped to gemini-2.5-flash.
# Used by: src/lib/ai/config.ts:24
# GEMINI_MODEL=gemini-2.5-flash


# ── RATE LIMITING (UPSTASH REDIS) ─────────────────────────────────────
# OPTIONAL | SERVER-ONLY
# When both are set, distributed rate limiting is enforced on AI and reset endpoints.
# When absent, falls back to a safe in-memory limiter (suitable for dev/single-instance).
# Used by: src/lib/security/rate-limit.ts
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ── WEB PUSH NOTIFICATIONS (VAPID) ────────────────────────────────────
# OPTIONAL | PUBLIC | browser only
# VAPID public key passed to the browser PushManager for push subscriptions.
# Generate with: npx web-push generate-vapid-keys
# Used by: src/lib/notifications/vapid.ts
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# NOT CURRENTLY REFERENCED IN SOURCE CODE
# VAPID_PRIVATE_KEY and VAPID_SUBJECT have zero process.env references in
# the current codebase. Included here for future server-side push sending.
# Safe to omit — push subscriptions work without them.
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com


# ── AUTOMATICALLY PROVIDED BY NEXT.JS / VERCEL ────────────────────────
# Do NOT set these manually — they are injected by the runtime.
#
# NODE_ENV=development|production|test
#   Guards console.log in API routes and enables/disables unsafe-eval in CSP.
#   Source: next.config.ts:3, src/app/api/chat/route.ts, reset-data/route.ts

