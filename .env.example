# ─── Supabase ───────────────────────────────────────────────────────────────
# Browser/client access — safe to expose in NEXT_PUBLIC_*
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only privileged access — NEVER expose with NEXT_PUBLIC_ and NEVER commit values
SUPABASE_SECRET_KEY=

# ─── CRON & Background Jobs ─────────────────────────────────────────────────
CRON_SECRET=

# ─── AI ─────────────────────────────────────────────────────────────────────
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: override the default AI model (default: gemini-2.5-flash)
GEMINI_MODEL=

# ─── Rate Limiting (Upstash Redis) ──────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Web Push Notifications ─────────────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
