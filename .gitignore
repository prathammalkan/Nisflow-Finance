*.pem
*.key
*.p12
*.pfx

# Supabase local / generated state
supabase/.temp/
supabase/.branches/

# Local audit / scratch output
audit-npm.json
scratch/

# Secrets accidentally generated by tooling
*.secret
*.secrets
credentials.json
service-account*.json

# Playwright auth state (contains session cookies - never commit)
playwright/.auth/user.json
playwright-report/
test-results/
