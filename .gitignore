# Dependencies
/node_modules/
/.pnp/
.pnp.js
.yarn/install-state.gz

# Next.js / build output
/.next/
/out/
/build/

# Test / coverage
/coverage/

# Local tooling / generated artifacts
/.vercel/
/.turbo/
*.tsbuildinfo
next-env.d.ts

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Logs / debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# Environment files — never commit credentials
.env
.env.*
!.env.example
!.env.template

